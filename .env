# ==========================================
# LOGMOVY - API DE GESTÃO DE MOTOBOYS (PORTA 8020)
# Conecta diretamente ao banco já existente do C:\git\CadastroMotoboys
# ==========================================

APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo

APP_BASE_PATH=/Motoboys

# Portas expostas no Host Docker
API_PORT=8020
PHPMYADMIN_PORT=8021

# Segurança / CORS / Admin Key
CORS_ALLOWED_ORIGINS=https://logmovy.kodyvera.com,http://logmovy.kodyvera.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8020,*
ADMIN_API_KEY=lmv_admin_secret_key_2026_prod
TERMS_CURRENT_VERSION=1.1

# URL de Login do Sistema do Motoboy (enviada no Template de Boas-Vindas)
MOTOBOY_LOGIN_URL=https://logmovy.kodyvera.com/login

# Configurações opcionais de SMTP para envio automático do E-mail de Boas-Vindas
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=operacao@logmovy.com.br
SMTP_FROM_NAME=LogMovy Operações

# Conexão direta com o MySQL já existente do C:\git\CadastroMotoboys (porta 3307)
DB_HOST=host.docker.internal
DB_PORT=3307
DB_DATABASE=logmovy_cadastro
DB_USERNAME=logmovy_user
DB_PASSWORD=logmovy_pass_secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Rate Limiting
RATE_LIMIT_GENERAL_PER_MIN=300
