# ==========================================
# LOGMOVY - API DE GESTÃO DE MOTOBOYS (PORTA 8020)
# Compartilha o mesmo banco de dados do CadastroMotoboys
# ==========================================

APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo

# Subcaminho caso hospedado em subdiretório (ex.: /Motoboys na Hostinger)
APP_BASE_PATH=/Motoboys

# Portas expostas no Host Docker
API_PORT=8020
PHPMYADMIN_PORT=8021
MYSQL_PORT=3320

# Segurança / CORS / Admin Key (mesma chave usada pelo painel Gest-oLogMovy)
CORS_ALLOWED_ORIGINS=https://logmovy.kodyvera.com,http://logmovy.kodyvera.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8020,*
ADMIN_API_KEY=lmv_admin_secret_key_2026_prod
TERMS_CURRENT_VERSION=1.1

# Banco de Dados Compartilhado com C:\git\CadastroMotoboys
# No Docker local, tenta conectar primeiro no MySQL do CadastroMotoboys (host.docker.internal:3307)
# e, se não estiver ativo, usa o container mysql local (mysql:3306) com a mesma base logmovy_cadastro.
SHARED_DB_HOST=host.docker.internal
SHARED_DB_PORT=3307

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=logmovy_cadastro
DB_USERNAME=logmovy_user
DB_PASSWORD=logmovy_pass_secret
DB_ROOT_PASSWORD=logmovy_root_secret

# phpMyAdmin aponta para o banco compartilhado do CadastroMotoboys (3307)
PMA_HOST=host.docker.internal
PMA_PORT=3307

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Rate Limiting
RATE_LIMIT_GENERAL_PER_MIN=300

