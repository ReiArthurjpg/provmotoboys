APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_BASE_PATH=/Motoboys

API_PORT=8020
PHPMYADMIN_PORT=8021
MYSQL_PORT=3320

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
ADMIN_API_KEY=lmv_admin_secret_key_2026_prod
TERMS_CURRENT_VERSION=1.1

SHARED_DB_HOST=host.docker.internal
SHARED_DB_PORT=3307

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=logmovy_cadastro
DB_USERNAME=logmovy_user
DB_PASSWORD=logmovy_pass_secret
DB_ROOT_PASSWORD=logmovy_root_secret

REDIS_HOST=redis
REDIS_PORT=6379
RATE_LIMIT_GENERAL_PER_MIN=300

